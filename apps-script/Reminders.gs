/** Email reminders are optional and sent only to family members who explicitly enabled them. */
function installReminderTrigger_(){const name='runDailyReminders_';ScriptApp.getProjectTriggers().filter(t=>t.getHandlerFunction()===name).forEach(ScriptApp.deleteTrigger);ScriptApp.newTrigger(name).timeBased().everyHours(1).create();console.log('Hourly reminder trigger installed (actual fire time may vary)')}
function runDailyReminders_(){return fmutex_(()=>{const props=PropertiesService.getScriptProperties(),tz=props.getProperty('FAMILY_TIMEZONE')||Session.getScriptTimeZone(),now=new Date(),day=Utilities.formatDate(now,tz,'yyyy-MM-dd'),hour=Number(Utilities.formatDate(now,tz,'H'));const members=frows_('FamilyMembers'),tx=frows_('Transactions'),sent=frows_('ReminderLog');let total=0;members.forEach(m=>{if(m.status!=='active'||String(m.remind_enabled)!=='true'||!m.email)return;if(hour<Number(m.remind_hour)||hour>23)return;if(tx.some(t=>String(t.actor_id)===String(m.id)&&String(t.date)===day))return;if(sent.some(x=>String(x.member_id)===String(m.id)&&String(x.day)===day))return;const logId=Utilities.getUuid();fappend_('ReminderLog',{id:logId,member_id:m.id,day,sent_at:new Date().toISOString(),status:'pending'});try{MailApp.sendEmail({to:String(m.email),subject:'Мои Финансы — заполните операции за сегодня',body:'Здравствуйте, '+String(m.name)+'!\n\nЗа сегодня ещё нет записанных вами финансовых операций. Откройте приложение «Мои Финансы» и проверьте, все ли расходы и доходы внесены.\n\nЕсли операций сегодня не было, ничего добавлять не нужно.\n\nЭто напоминание включается и выключается в настройках вашего профиля.'});fmodify_('ReminderLog',logId,{status:'sent'});total++}catch(error){fmodify_('ReminderLog',logId,{status:'error'});console.error('Reminder delivery failed for member '+m.id)}});return{day,sent:total}})}
